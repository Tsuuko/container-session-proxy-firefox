{
  "name": "container-session-proxy-firefox",
  "description": "Firefox container session proxy manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv2",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv2",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv2",
    "compile": "tsc --noEmit",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "oxfmt": "^0.58.0",
    "typescript": "^7.0.2",
    "wxt": "^0.20.27"
  }
}
